<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0;netstandard2.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702</NoWarn>
    <PackageId>TextChunker</PackageId>
    <RootNamespace>TextChunker</RootNamespace>
    <Description>Best-of-breed, tokenizer-agnostic text chunking for RAG and embedding pipelines. Async streaming API, exact token-boundary slicing, a recursive splitter plus fixed/sentence/paragraph/regex/list/table strategies, and pluggable cl100k, o200k, and BERT WordPiece tokenizers with per-model budget resolution.</Description>
    <PackageTags>chunking;rag;tokenizer;embeddings;nlp;text;wordpiece;cl100k;o200k;recursive;semantic</PackageTags>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/jchristn/TextChunker</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jchristn/TextChunker</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageReference Include="SharpToken" Version="2.0.6" />
  </ItemGroup>

  <!-- Polyfills required only when targeting netstandard2.0. These types are in-box on net8.0 and net10.0.
       Versions match what Microsoft.ML.Tokenizers pulls transitively on netstandard2.0 to avoid downgrades. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.4" />
    <PackageReference Include="System.Text.Json" Version="9.0.4" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="9.0.4" />
    <!-- Override the transitive 9.0.4 pulled by Microsoft.ML.Tokenizers; 9.0.14 patches CVE-2026-26127. -->
    <PackageReference Include="Microsoft.Bcl.Memory" Version="9.0.14" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Tokenization\Data\bert-base-uncased-vocab.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Test.Shared" />
    <InternalsVisibleTo Include="TextChunker.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.ico" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
